{
  "name": "volunteerops-backend",
  "version": "2.0.0",
  "description": "Enterprise Real-Time Disaster Response and Operational Field Management Platform Backend",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run prisma7:generate && npm run prisma8:emit",
    "build": "tsc -p tsconfig.json && npm run build:portal",
    "start": "node dist/index.js",
    "worker:identity": "node dist/workers/identity.worker.js",
    "worker:device": "node dist/workers/device.worker.js",
    "identity:operator": "tsx scripts/identity-operator.ts",
    "prisma7:generate": "prisma7 generate",
    "prisma7:studio": "prisma7 studio",
    "prisma7:validate": "prisma7 validate",
    "prisma:generate": "npm run prisma7:generate",
    "prisma:migrate": "npm run prisma8:migrate",
    "prisma:deploy": "npm run prisma8:migrate",
    "prisma:studio": "npm run prisma7:studio",
    "prisma:validate": "npm run prisma7:validate",
    "prisma8:infer": "prisma contract infer --output prisma8/contract.prisma",
    "prisma8:emit": "prisma contract emit",
    "prisma8:plan": "prisma contract emit && prisma migration plan",
    "prisma8:migrate": "prisma db migrate --advance-ref db",
    "prisma8:status": "prisma migration status",
    "prisma8:check": "prisma migration check",
    "prisma8:verify": "prisma db verify",
    "accelerate:test": "tsx scripts/test_accelerate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:types": "tsc -p tsconfig.tests.json",
    "db:readiness": "tsx scripts/check-database.ts",
    "worker:forecast": "node dist/workers/forecast.worker.js",
    "worker:sources": "node dist/workers/sources.worker.js",
    "build:portal": "tsc -p tsconfig.portal.json && node scripts/build-portal.mjs",
    "test:portal": "playwright test --config playwright.portal.config.ts",
    "retention:once": "node dist/workers/retention.worker.js",
    "test:object-store": "node --test deploy/object-store/gateway.test.mjs",
    "contracts:generate": "node --import tsx scripts/generate-openapi.mjs",
    "contracts:check": "node --import tsx scripts/generate-openapi.mjs --check",
    "worker:storage": "node dist/workers/storage.worker.js",
    "railway:migrate": "node scripts/railway-migrate.mjs",
    "worker:invitation-email": "node dist/workers/invitation-email.worker.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@google-cloud/bigquery": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma/composer": "0.16.0",
    "@prisma/composer-prisma-cloud": "0.16.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@prisma/prisma7": "7.10.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@vercel/nft": "1.11.0",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "mapbox-gl": "^3.32.0",
    "prisma": "8.0.0-rc.12",
    "railway": "3.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "zod-to-json-schema": "3.25.1"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11.6.0"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@prisma/config": {
      "effect": "3.20.0"
    },
    "effect": "4.0.0-rc.112"
  }
}
