{
  "info": {
    "name": "VolunteerOps Enterprise Platform API",
    "description": "Production REST API for VolunteerOps real-time disaster response and operational field management platform.\n\nSupports:\n- Volunteer & Field Responder App (Android / iOS / Web)\n- Admin & Command Portal (Desktop / Android / iOS / Web)\n- Public Landing Site & Contact Ingestion Pipeline\n\nAuthentication:\n- Dual-mode support: httpOnly cookie 'vops_session' OR 'Authorization: Bearer {{authToken}}' header.\n- Run '02 Auth -> Login (Admin)' to automatically capture the JWT token into the {{authToken}} collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "volunteerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "deploymentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "skillId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "locationId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "channelId",
      "value": "alerts",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
