    {
      "name": "02 Authentication & Identity",
      "item": [
        {
          "name": "POST /auth/login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var token = json.access_token || json.accessToken || json.token;",
                  "    var refresh = json.refresh_token || json.refreshToken;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('authToken', token);",
                  "        console.log('Saved authToken variable');",
                  "    }",
                  "    if (refresh) {",
                  "        pm.collectionVariables.set('refreshToken', refresh);",
                  "        console.log('Saved refreshToken variable');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@volunteerops.org\",\n  \"password\": \"AdminPass@2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "POST /auth/login (Volunteer)",
