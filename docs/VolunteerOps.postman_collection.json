        },
        {
          "name": "POST /auth/refresh (Rotate Tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var token = json.access_token || json.accessToken || json.token;",
                  "    var refresh = json.refresh_token || json.refreshToken;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('authToken', token);",
                  "        console.log('Updated authToken variable');",
                  "    }",
                  "    if (refresh) {",
                  "        pm.collectionVariables.set('refreshToken', refresh);",
                  "        console.log('Updated refreshToken variable');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        },
