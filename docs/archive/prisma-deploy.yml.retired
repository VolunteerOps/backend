name: prisma-deploy

on:
  workflow_dispatch:
    inputs:
      approved_cutover:
        description: Confirm reviewed PG18/Firebase/tenant gates and authorized production cutover
        type: boolean
        required: true
        default: false

concurrency:
  group: prisma-deploy-production
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  deploy:
    if: github.ref == 'refs/heads/main' && inputs.approved_cutover && vars.SENTINEL_DEPLOYMENT_APPROVED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    env:
      PRISMA_SERVICE_TOKEN: ${{ secrets.PRISMA_SERVICE_TOKEN }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: 1.4.2
      - name: Require deployment credentials
        run: test -n "$PRISMA_SERVICE_TOKEN"
      - run: npm ci
      - name: Deploy web service without provisioning a database
        run: npm run compute:deploy -- --project proj_cmsyg6b0h0m1e12faar3bwvyb --branch main --prod --yes --no-db --no-interactive --json
      - name: Verify public health
        run: curl --fail --retry 5 --retry-delay 5 https://rh90d59tnjxx4y2te8lm5j44.fra.prisma.build/api/health
