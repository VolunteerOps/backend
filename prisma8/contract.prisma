  model Organization {
    id String @id
    slug String @unique
    displayName String @map("display_name")
    status String @default("PROVISIONED")
    version Int @default(1)
    enrollmentReady Boolean @default(false) @map("enrollment_ready")
    verificationEvidence String? @map("verification_evidence")
    allowedProviders String[] @map("allowed_providers")
    requireMfa Boolean @default(false) @map("require_mfa")
    createdAt Timestamp(3) @default(now()) @map("created_at")
    updatedAt Timestamp(3) @default(now()) @map("updated_at")
    @@map("organizations")
    @@rls
    @@check(expression: "status IN ('PROVISIONED', 'ACTIVE', 'SUSPENDED', 'OFFBOARDING', 'ARCHIVED')", name: "organization_status")
    @@check(expression: "version > 0", name: "organization_version")
  }

  model OrganizationMembership {
    id String @id
    organizationId String @map("organization_id")
    userId Int @map("user_id")
    role String @default("VOLUNTEER")
    status String @default("ACTIVE")
    version Int @default(1)
    regionIds String[] @default([]) @map("region_ids")
    createdAt Timestamp(3) @default(now()) @map("created_at")
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    user Users @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    @@unique([organizationId, id])
    @@unique([organizationId, userId])
    @@index([userId])
    @@map("organization_memberships")
    @@rls
    @@check(expression: "role IN ('ORG_ADMIN', 'COORDINATOR', 'TEAM_LEAD', 'VOLUNTEER')", name: "membership_role")
    @@check(expression: "status IN ('ACTIVE', 'SUSPENDED', 'REMOVED')", name: "membership_status")
  }

  model PlatformGrant {
    userId Int @id @map("user_id")
    role String @default("TECH_ADMIN")
    active Boolean @default(true)
    createdAt Timestamp(3) @default(now()) @map("created_at")
    user Users @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    @@map("platform_grants")
    @@rls
    @@check(expression: "role = 'TECH_ADMIN'", name: "platform_grant_role")
  }

  model OrganizationInvitation {
    id String @id
    organizationId String @map("organization_id")
    recipientEmail String @map("recipient_email")
    role String
    regionIds String[] @default([]) @map("region_ids")
    tokenHash String @unique @map("token_hash")
    issuerUserId Int @map("issuer_user_id")
    expiresAt Timestamp(3) @map("expires_at")
    acceptedByUserId Int? @map("accepted_by_user_id")
    acceptedAt Timestamp(3)? @map("accepted_at")
    revokedAt Timestamp(3)? @map("revoked_at")
    createdAt Timestamp(3) @default(now()) @map("created_at")
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    issuer Users @relation(fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    @@index([organizationId])
    @@map("organization_invitations")
    @@rls
    @@check(expression: "role IN ('ORG_ADMIN', 'COORDINATOR', 'TEAM_LEAD', 'VOLUNTEER')", name: "invitation_role")
  }

  model OrganizationAudit {
    id String @id
    organizationId String @map("organization_id")
    actorUserId Int @map("actor_user_id")
    action String
    reason String
    metadata Jsonb
    createdAt Timestamp(3) @default(now()) @map("created_at")
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    actor Users @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    @@index([organizationId, createdAt])
    @@map("organization_audit")
    @@rls
  }
  policy_select platform_self {
    target = PlatformGrant
    using = "user_id = nullif(current_setting('vops.user_id', true), '')::integer"
