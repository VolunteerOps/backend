    withCheck = "(current_setting('vops.platform', true) = 'true' AND EXISTS (SELECT 1 FROM public.platform_grants g WHERE g.user_id = nullif(current_setting('vops.user_id', true), '')::integer AND g.active AND g.role = 'TECH_ADMIN')) OR (organization_id = nullif(current_setting('vops.organization_id', true), '') AND current_setting('vops.roster', true) = 'true') OR (token_hash = nullif(current_setting('vops.invitation_hash', true), '') AND recipient_email = current_setting('vops.email', true))"
  }

  policy_select audit_read {
    target = OrganizationAudit
    using = "(current_setting('vops.platform', true) = 'true' AND EXISTS (SELECT 1 FROM public.platform_grants g WHERE g.user_id = nullif(current_setting('vops.user_id', true), '')::integer AND g.active AND g.role = 'TECH_ADMIN')) OR (organization_id = nullif(current_setting('vops.organization_id', true), '') AND current_setting('vops.roster', true) = 'true')"
  }

  policy_insert audit_append {
    target = OrganizationAudit
    withCheck = "actor_user_id = nullif(current_setting('vops.user_id', true), '')::integer AND ((current_setting('vops.platform', true) = 'true' AND EXISTS (SELECT 1 FROM public.platform_grants g WHERE g.user_id = nullif(current_setting('vops.user_id', true), '')::integer AND g.active AND g.role = 'TECH_ADMIN')) OR organization_id = nullif(current_setting('vops.organization_id', true), ''))"
  }

  model DurableJob {
    organizationId String? @map("organization_id")
    priority Int @default(1)
    lastClaimedAt Timestamp(3)? @map("last_claimed_at")
    @@index([queue, organizationId, lastClaimedAt], map: "durable_jobs_tenant_fairness_idx")
    id String @id
    queue String
    kind String
    businessKey String @unique @map("business_key")
    payload Jsonb
    state String @default("PENDING")
    attempts Int @default(0)
    maxAttempts Int @default(8) @map("max_attempts")
    fence Int @default(0)
    leaseOwner String? @map("lease_owner")
    leaseUntil Timestamp(3)? @map("lease_until")
    availableAt Timestamp(3) @default(now()) @map("available_at")
    deadline Timestamp(3)?
    lastError String? @map("last_error")
    createdAt Timestamp(3) @default(now()) @map("created_at")
    completedAt Timestamp(3)? @map("completed_at")

    @@index([queue, state, availableAt], map: "durable_jobs_claim_idx")
    @@map("durable_jobs")
  }

  model FirebaseIdentity {
    id Int @id @default(autoincrement())
    projectId String @map("project_id")
    uid String
    userId Int @unique @map("user_id")
    revokedBefore Timestamp(3)? @map("revoked_before")
    createdAt Timestamp(3) @default(now()) @map("created_at")
    user Users @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@unique([projectId, uid])
    @@map("firebase_identities")
  }

  model Users {
    id            Int               @id(map: "users_pkey") @default(autoincrement())
    email         String
    passwordHash  String?           @map("password_hash")
    fullName      String            @map("full_name")
    role          pg.enum(UserRole) @default("VOLUNTEER")
    phoneNumber   String?           @map("phone_number")
    avatarUrl     String?           @map("avatar_url")
    isActive      Boolean           @default(true) @map("is_active")
    lastLoginAt   Timestamp(3)?     @map("last_login_at")
    createdAt     Timestamp(3)      @default(now()) @map("created_at")
    updatedAt     Timestamp(3)      @map("updated_at")
    auditLogs     AuditLogs[]
    refreshTokens RefreshTokens[]
    volunteers    Volunteers[]

    @@index([email], map: "users_email_key", unique: true)
    @@map("users")
  }

  model AuditLogs {
    id         Int          @id(map: "audit_logs_pkey") @default(autoincrement())
    userId     Int?         @map("user_id")
    action     String
    entityType String       @map("entity_type")
    entityId   Int?         @map("entity_id")
    oldValues  Jsonb?       @map("old_values")
    newValues  Jsonb?       @map("new_values")
    ipAddress  String?      @map("ip_address")
    userAgent  String?      @map("user_agent")
    createdAt  Timestamp(3) @default(now()) @map("created_at")
    user       Users?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "audit_logs_user_id_fkey", index: false)

    @@index([entityType, entityId], map: "idx_audit_entity")
    @@map("audit_logs")
  }

  model Locations {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

    id           Int            @id(map: "locations_pkey") @default(autoincrement())
    name         String
    address      String
    city         String?
    state        String?
    country      String?        @default("USA")
    latitude     Numeric(10, 7)
    longitude    Numeric(10, 7)
    osmId        Int?           @map("osm_id")
    hazardLevel  String         @default("low") @map("hazard_level")
    radiusMeters Int            @default(5000) @map("radius_meters")
    createdAt    Timestamp(3)   @default(now()) @map("created_at")
    events       Events[]

    @@index([latitude, longitude], map: "idx_locations_coords")
    @@map("locations")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, index: false)
  @@unique([organizationId, id], map: "locations_org_id_key")
  @@index([organizationId, regionId], map: "locations_scope_idx")
  @@rls
  }

  model Events {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

    id                 Int                      @id(map: "events_pkey") @default(autoincrement())
    eventName          String                   @map("event_name")
    eventType          String                   @map("event_type")
    priority           pg.enum(MissionPriority) @default("MEDIUM")
    description        String
    startDate          Timestamp(3)             @map("start_date")
    endDate            Timestamp(3)?            @map("end_date")
    locationId         Int                      @map("location_id")
    status             pg.enum(MissionStatus)   @default("ACTIVE")
    requiredVolunteers Int                      @default(10) @map("required_volunteers")
    coordinatorName    String?                  @map("coordinator_name")
    coordinatorId      Int?                     @map("coordinator_id")
    requiredSkills     Jsonb?                   @map("required_skills")
    tags               String[]                 @default([]) @noCheck(elementNotNull)
    createdAt          Timestamp(3)             @default(now()) @map("created_at")
    updatedAt          Timestamp(3)             @map("updated_at")
    communications     Communications[]
    deployments        Deployments[]
    feedbacks          Feedback[]
    notifications      Notifications[]
    location           Locations?                @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "events_location_id_fkey", index: false)

    @@index([status, priority], map: "idx_events_status_priority")
    @@map("events")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, index: false)
  @@unique([organizationId, id], map: "events_org_id_key")
  @@index([organizationId, regionId], map: "events_scope_idx")
  @@rls
  }

  model Communications {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

    id          Int          @id(map: "communications_pkey") @default(autoincrement())
    eventId     Int?         @map("event_id")
    channelId   String       @default("general") @map("channel_id")
    senderId    Int?         @map("sender_id")
    senderName  String       @map("sender_name")
    senderRole  String       @default("coordinator") @map("sender_role")
    message     String
    priority    String       @default("normal")
    messageType String       @default("text") @map("message_type")
    mediaUrl    String?      @map("media_url")
    createdAt   Timestamp(3) @default(now()) @map("created_at")
    event       Events?      @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "communications_event_id_fkey", index: false)

    @@index([channelId, createdAt], map: "idx_communications_channel")
    @@map("communications")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, index: false)
  @@unique([organizationId, id], map: "communications_org_id_key")
  @@index([organizationId, regionId], map: "communications_scope_idx")
  @@rls
  }

