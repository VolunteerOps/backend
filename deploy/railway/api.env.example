NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://sentinel_api:REPLACE@resq-postgres.railway.internal:5432/volunteerops?sslmode=verify-full
DATABASE_TLS_CA=REPLACE_WITH_CA_PEM
DATABASE_POOL_MAX=3
COOKIE_SECURE=true
CORS_ORIGIN=https://www.admin.resq-app.co.ke,https://app.resq-app.co.ke,https://api.resq-app.co.ke,https://resq-app.co.ke
# Set only after inspecting the actual ingress peer; empty trusts no proxy.
TRUST_PROXY_CIDRS=
GOOGLE_CREDENTIALS_REQUIRED=true
GOOGLE_SERVICE_ACCOUNT_B64=REPLACE_WITH_SERVICE_SPECIFIC_SECRET
WEATHERNEXT_ACCESS_ENABLED=false
SENTINEL_USGS_ENABLED=false

# Public browser registrations in the same Firebase project
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_OPS_WEB_API_KEY=
FIREBASE_OPS_WEB_AUTH_DOMAIN=
FIREBASE_OPS_WEB_APP_ID=
# Public map token only; never use a Mapbox sk. token here
MAPBOX_ACCESS_TOKEN=
# Server-only RevenueCat subscriber-read keys (separate projects supported)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_OPS_SECRET_API_KEY=
SENTINEL_GEMINI_API_KEY=
SENTINEL_GEMINI_MODEL=

# Explicit staging/test UID allowlist only; never permits production sandbox grants.
REVENUECAT_ALLOW_SANDBOX=false
REVENUECAT_SANDBOX_UIDS=

# 32 random bytes as 64 hex characters. Rotation invalidates replay cursors.
OPERATIONS_CURSOR_KEY=
