NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://sentinel_api:REPLACE@resq-postgres.railway.internal:5432/volunteerops?sslmode=verify-full
DATABASE_TLS_CA=REPLACE_WITH_CA_PEM
DATABASE_POOL_MAX=3
COOKIE_SECURE=true
CORS_ORIGIN=https://www.admin.resq-app.co.ke,https://app.resq-app.co.ke,https://api.resq-app.co.ke,https://resq-app.co.ke
# Set only after inspecting the actual ingress peer; empty trusts no proxy.
TRUST_PROXY_CIDRS=
GOOGLE_CREDENTIALS_REQUIRED=true
GOOGLE_SERVICE_ACCOUNT_B64=REPLACE_WITH_SERVICE_SPECIFIC_SECRET
WEATHERNEXT_ACCESS_ENABLED=false
SENTINEL_USGS_ENABLED=false
