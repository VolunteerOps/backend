# Copy to .sentinel-deploy/prisma/runtime.env and edit locally.
# Upload ONLY that file, never the root .env or migration.env.
# This template is not deployable until the runbook's database/auth/worker gates pass.
NODE_ENV=production
PORT=3001
COOKIE_SECURE=true
DATABASE_URL=postgresql://RESTRICTED_RUNTIME:ENCODED_PASSWORD@COMPATIBLE_HOST/DATABASE?sslmode=verify-full
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
CORS_ORIGIN=https://ADMIN_ORIGIN,https://VOLUNTEER_ORIGIN
S3_ENDPOINT=https://PROVIDER_ENDPOINT
S3_BUCKET=PROVIDER_ASSIGNED_BUCKET_NAME
S3_ACCESS_KEY_ID=REPLACE_LOCALLY
S3_SECRET_ACCESS_KEY=REPLACE_LOCALLY
S3_REGION=auto
# Use the addressing mode verified against this bucket. Not a Render requirement.
S3_FORCE_PATH_STYLE=false
FIREBASE_PROJECT_ID=REPLACE_WITH_VERIFIED_PROJECT_ID
FIREBASE_ALLOW_AUTH_EMULATOR=false
FIREBASE_WEB_API_KEY=REPLACE_WITH_PUBLIC_WEB_CONFIG
FIREBASE_WEB_AUTH_DOMAIN=REPLACE_WITH_PUBLIC_WEB_CONFIG
FIREBASE_WEB_APP_ID=REPLACE_WITH_PUBLIC_WEB_CONFIG
MAPBOX_ACCESS_TOKEN=REPLACE_WITH_ORIGIN_RESTRICTED_PUBLIC_PK_TOKEN
# Configure Firebase Admin ADC at runtime before activation; a Windows path is invalid on Compute.
# Never embed a service-account JSON file in the deployment artifact.
WEATHERNEXT_ACCESS_ENABLED=false
SENTINEL_USGS_ENABLED=false
LOG_LEVEL=info
