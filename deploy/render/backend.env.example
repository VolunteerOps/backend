# API runtime only. Fill privately before importing to Render.
# No migration URL, storage-root keys, Render token or maintenance credentials.
NODE_ENV=production
PORT=3001
COOKIE_SECURE=true
FIREBASE_ALLOW_AUTH_EMULATOR=false
DATABASE_URL="postgresql://sentinel_api:ENCODED_PASSWORD@EXTERNAL_RENDER_DB_HOST/volunteerops?sslmode=verify-full"
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
CORS_ORIGIN="https://API_ORIGIN,https://ADMIN_ORIGIN,https://VOLUNTEER_ORIGIN"
S3_ENDPOINT="https://ACTUAL_STORAGE_ORIGIN"
S3_BUCKET=volunteerops-production
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=BUCKET_SCOPED_KEY
S3_SECRET_ACCESS_KEY=BUCKET_SCOPED_SECRET
FIREBASE_PROJECT_ID=VERIFIED_FIREBASE_PROJECT
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
FIREBASE_WEB_API_KEY=PUBLIC_FIREBASE_WEB_API_KEY
FIREBASE_WEB_AUTH_DOMAIN=PUBLIC_FIREBASE_WEB_AUTH_DOMAIN
FIREBASE_WEB_APP_ID=PUBLIC_FIREBASE_WEB_APP_ID
MAPBOX_ACCESS_TOKEN=PUBLIC_ORIGIN_RESTRICTED_PK_TOKEN
WEATHERNEXT_ACCESS_ENABLED=false
SENTINEL_USGS_ENABLED=false
LOG_LEVEL=info
# Optional after verification: SENTINEL_GEMINI_API_KEY, SENTINEL_GEMINI_MODEL.
