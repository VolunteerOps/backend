datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum UserRole {
  SUPER_ADMIN
  COORDINATOR
  TEAM_LEAD
  VOLUNTEER
}

enum VolunteerStatus {
  ACTIVE
  DEPLOYED
  AVAILABLE
  RESTRICTED
  INACTIVE
}

enum MissionPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MissionStatus {
  STAGED
  ACTIVE
  CONTAINED
  COMPLETED
  CANCELLED
}

enum DeploymentStatus {
  ASSIGNED
  EN_ROUTE
  ON_SITE
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum ContactStatus {
  NEW
  IN_REVIEW
  RESPONDED
  RESOLVED
  ARCHIVED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  fullName     String     @map("full_name")
  role         UserRole   @default(VOLUNTEER)
  phoneNumber  String?    @map("phone_number")
  avatarUrl    String?    @map("avatar_url")
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  volunteer Volunteer[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  firebaseIdentity FirebaseIdentity?
  memberships OrganizationMembership[]
  platformGrant PlatformGrant?
  issuedInvitations OrganizationInvitation[]
  organizationAudits OrganizationAudit[]

  @@map("users")
}


model Organization {
  units OrganizationUnit[]
  ownedVolunteer Volunteer[]
  ownedSkill Skill[]
  ownedVolunteerSkill VolunteerSkill[]
  ownedLocation Location[]
  ownedEvent Event[]
  ownedDeployment Deployment[]
  ownedFieldReport FieldReport[]
  ownedCommunication Communication[]
  ownedNotification Notification[]
  ownedTelemetryPing TelemetryPing[]
  ownedFeedback Feedback[]

  id String @id
  slug String @unique
  displayName String @map("display_name")
  status String @default("PROVISIONED")
  version Int @default(1)
  enrollmentReady Boolean @default(false) @map("enrollment_ready")
  verificationEvidence String? @map("verification_evidence")
  allowedProviders String[] @map("allowed_providers")
  requireMfa Boolean @default(false) @map("require_mfa")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  audits OrganizationAudit[]
  @@map("organizations")
}

model OrganizationMembership {
  storedObjects StoredObject[]
  profiles Volunteer[]
  id String @id
  organizationId String @map("organization_id")
  userId Int @map("user_id")
  role String @default("VOLUNTEER")
  status String @default("ACTIVE")
  version Int @default(1)
  regionIds String[] @default([]) @map("region_ids")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  devices MemberDevice[]
  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId], map: "organization_memberships_user_id_idx_6c952402")
  @@map("organization_memberships")
}

model PlatformGrant {
  userId Int @id @map("user_id")
  role String @default("TECH_ADMIN")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@map("platform_grants")
}

model OrganizationInvitation {
  id String @id
  organizationId String @map("organization_id")
  recipientEmail String @map("recipient_email")
  role String
  regionIds String[] @default([]) @map("region_ids")
  tokenHash String @unique @map("token_hash")
  issuerUserId Int @map("issuer_user_id")
  expiresAt DateTime @map("expires_at")
  acceptedByUserId Int? @map("accepted_by_user_id")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  issuer User @relation(fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([organizationId], map: "organization_invitations_organization_id_idx_1a5cd3f5")
  @@map("organization_invitations")
}

model OrganizationAudit {
  id String @id
  organizationId String @map("organization_id")
  actorUserId Int @map("actor_user_id")
  action String
  reason String
  metadata Json
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([organizationId, createdAt], map: "organization_audit_organization_id_created_at_idx_86b4d119")
  @@map("organization_audit")
}

model DurableJob {
    organizationId String? @map("organization_id")
    priority Int @default(1)
    lastClaimedAt DateTime? @map("last_claimed_at")
    @@index([queue, organizationId, lastClaimedAt], map: "durable_jobs_tenant_fairness_idx")
  id String @id
  queue String
  kind String
  businessKey String @unique @map("business_key")
  payload Json
  state String @default("PENDING")
  attempts Int @default(0)
  maxAttempts Int @default(8) @map("max_attempts")
  fence Int @default(0)
  leaseOwner String? @map("lease_owner")
  leaseUntil DateTime? @map("lease_until")
  availableAt DateTime @default(now()) @map("available_at")
  deadline DateTime?
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([queue, state, availableAt], map: "durable_jobs_claim_idx")
  @@map("durable_jobs")
}

model FirebaseIdentity {
  id Int @id @default(autoincrement())
  projectId String @map("project_id")
  uid String
  userId Int @unique @map("user_id")
  revokedBefore DateTime? @map("revoked_before")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, uid])
  @@map("firebase_identities")
}

model Volunteer {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id                  Int             @id @default(autoincrement())
  userId              Int? @map("user_id")
  fullName            String          @map("full_name")
  phoneNumber         String          @map("phone_number")
  email               String
  registrationChannel String          @default("inbuilt") @map("registration_channel")
  consentGiven        Boolean         @default(true) @map("consent_given")
  registrationDate    DateTime        @default(now()) @map("registration_date")
  status              VolunteerStatus @default(AVAILABLE)
  dateOfBirth         DateTime?       @map("date_of_birth")
  emergencyContact    String?         @map("emergency_contact")
  bio                 String?
  availabilitySchedule Json?          @map("availability_schedule")
  address             String?
  latitude            Decimal?        @db.Decimal(10, 7)
  longitude           Decimal?        @db.Decimal(10, 7)
  avatarUrl           String?         @map("avatar_url")
  totalHours          Decimal         @default(0) @db.Decimal(10, 2) @map("total_hours")
  badgeCount          Int             @default(0) @map("badge_count")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  skills              VolunteerSkill[]
  deployments         Deployment[]
  notifications       Notification[]
  feedback            Feedback[]
  telemetryPings      TelemetryPing[]

  @@index([status], map: "idx_volunteers_status")
  @@index([latitude, longitude], map: "idx_volunteers_geo")
  @@map("volunteers")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "volunteers_org_id_key")
  @@index([organizationId, regionId], map: "volunteers_scope_idx")
  @@unique([organizationId, userId], map: "volunteers_org_user_key")
  @@unique([organizationId, email], map: "volunteers_org_email_key")
  membership OrganizationMembership? @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Cascade)
}

model Skill {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id          Int      @id @default(autoincrement())
  skillName   String @map("skill_name")
  category    String
  demandLevel String   @default("medium") @map("demand_level")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  volunteerSkills VolunteerSkill[]

  @@index([category], map: "idx_skills_category")
  @@map("skills")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "skills_org_id_key")
  @@index([organizationId, regionId], map: "skills_scope_idx")
  @@unique([organizationId, skillName], map: "skills_org_name_key")
}

model VolunteerSkill {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id               Int       @id @default(autoincrement())
  volunteerId      Int       @map("volunteer_id")
  skillId          Int       @map("skill_id")
  proficiencyLevel String    @default("intermediate") @map("proficiency_level")
  isCertified      Boolean   @default(false) @map("is_certified")
  certificationDate DateTime? @map("certification_date")
  certifiedBy      String?   @map("certified_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  volunteer        Volunteer? @relation(fields: [organizationId, volunteerId], references: [organizationId, id], onDelete: Cascade)
  skill            Skill?     @relation(fields: [organizationId, skillId], references: [organizationId, id], onDelete: Cascade)

  @@unique([volunteerId, skillId])
  @@map("volunteer_skills")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "volunteer_skills_org_id_key")
  @@index([organizationId, regionId], map: "volunteer_skills_scope_idx")
}

model Location {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id           Int      @id @default(autoincrement())
  name         String
  address      String
  city         String?
  state        String?
  country      String?  @default("USA")
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  osmId        Int?     @map("osm_id")
  hazardLevel  String   @default("low") @map("hazard_level")
  radiusMeters Int      @default(5000) @map("radius_meters")
  createdAt    DateTime @default(now()) @map("created_at")

  events       Event[]

  @@index([latitude, longitude], map: "idx_locations_coords")
  @@map("locations")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "locations_org_id_key")
  @@index([organizationId, regionId], map: "locations_scope_idx")
}

model Event {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id                 Int             @id @default(autoincrement())
  eventName          String          @map("event_name")
  eventType          String          @map("event_type")
  priority           MissionPriority @default(MEDIUM)
  description        String
  startDate          DateTime        @map("start_date")
  endDate            DateTime?       @map("end_date")
  locationId         Int             @map("location_id")
  status             MissionStatus   @default(ACTIVE)
  requiredVolunteers Int             @default(10) @map("required_volunteers")
  coordinatorName    String?         @map("coordinator_name")
  coordinatorId      Int?            @map("coordinator_id")
  requiredSkills     Json?           @map("required_skills")
  tags               String[]        @default([])
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  location           Location?        @relation(fields: [organizationId, locationId], references: [organizationId, id])
  deployments        Deployment[]
  notifications      Notification[]
  communications     Communication[]
  feedback           Feedback[]

  @@index([status, priority], map: "idx_events_status_priority")
  @@map("events")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "events_org_id_key")
  @@index([organizationId, regionId], map: "events_scope_idx")
}

model Deployment {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id               Int              @id @default(autoincrement())
  volunteerId      Int              @map("volunteer_id")
  eventId          Int              @map("event_id")
  assignedBy       Int?             @map("assigned_by")
  assignedAt       DateTime         @default(now()) @map("assigned_at")
  checkInTime      DateTime?        @map("check_in_time")
  checkInLatitude  Decimal?         @map("check_in_latitude") @db.Decimal(10, 7)
  checkInLongitude Decimal?         @map("check_in_longitude") @db.Decimal(10, 7)
  checkInMethod    String?          @map("check_in_method")
  completedAt      DateTime?        @map("completed_at")
  status           DeploymentStatus @default(ASSIGNED)
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  volunteer        Volunteer?        @relation(fields: [organizationId, volunteerId], references: [organizationId, id])
  event            Event?            @relation(fields: [organizationId, eventId], references: [organizationId, id])
  fieldReports     FieldReport[]
  feedback         Feedback[]

  @@index([volunteerId, eventId], map: "idx_deployments_volunteer_event")
  @@index([status], map: "idx_deployments_status")
  @@map("deployments")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "deployments_org_id_key")
  @@index([organizationId, regionId], map: "deployments_scope_idx")
}

model FieldReport {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id            Int      @id @default(autoincrement())
  deploymentId  Int      @map("deployment_id")
  reportTime    DateTime @default(now()) @map("report_time")
  reportType    String   @map("report_type")
  priority      String   @default("medium")
  textResponse  String   @map("text_response")
  mediaUrl      String?  @map("media_url")
  fileUploadUrl String?  @map("file_upload_url")
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  submittedVia  String   @default("mobile_app") @map("submitted_via")
  status        String   @default("submitted")
  verifiedBy    String?  @map("verified_by")
  createdAt     DateTime @default(now()) @map("created_at")

  deployment    Deployment? @relation(fields: [organizationId, deploymentId], references: [organizationId, id])

  @@index([reportType, status], map: "idx_field_reports_type_status")
  @@map("field_reports")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "field_reports_org_id_key")
  @@index([organizationId, regionId], map: "field_reports_scope_idx")
}

model Communication {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id          Int      @id @default(autoincrement())
  eventId     Int?     @map("event_id")
  channelId   String   @default("general") @map("channel_id")
  senderId    Int?     @map("sender_id")
  senderName  String   @map("sender_name")
  senderRole  String   @default("coordinator") @map("sender_role")
  message     String
  priority    String   @default("normal")
  messageType String   @default("text") @map("message_type")
  mediaUrl    String?  @map("media_url")
  createdAt   DateTime @default(now()) @map("created_at")

  event       Event?   @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)

  @@index([channelId, createdAt], map: "idx_communications_channel")
  @@map("communications")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "communications_org_id_key")
  @@index([organizationId, regionId], map: "communications_scope_idx")
}

model Notification {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id               Int      @id @default(autoincrement())
  volunteerId      Int?     @map("volunteer_id")
  eventId          Int?     @map("event_id")
  notificationType String   @map("notification_type")
  priority         String   @default("normal")
  title            String   @default("Operational Alert")
  message          String
  sentAt           DateTime @default(now()) @map("sent_at")
  sentBy           Int?     @map("sent_by")
  status           String   @default("sent")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime @default(now()) @map("created_at")

  volunteer        Volunteer? @relation(fields: [organizationId, volunteerId], references: [organizationId, id], onDelete: Restrict)
  event            Event?     @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)

  @@index([volunteerId, status], map: "idx_notifications_volunteer")
  @@map("notifications")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "notifications_org_id_key")
  @@index([organizationId, regionId], map: "notifications_scope_idx")
}

model Feedback {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id           Int         @id @default(autoincrement())
  volunteerId  Int         @map("volunteer_id")
  deploymentId Int?        @map("deployment_id")
  eventId      Int?        @map("event_id")
  feedbackTime DateTime    @default(now()) @map("feedback_time")
  rating       Int
  comments     String
  submittedVia String      @default("mobile_app") @map("submitted_via")
  createdAt    DateTime    @default(now()) @map("created_at")

  volunteer    Volunteer?   @relation(fields: [organizationId, volunteerId], references: [organizationId, id])
  deployment   Deployment? @relation(fields: [organizationId, deploymentId], references: [organizationId, id])
  event        Event?      @relation(fields: [organizationId, eventId], references: [organizationId, id])

  @@map("feedback")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "feedback_org_id_key")
  @@index([organizationId, regionId], map: "feedback_scope_idx")
}

model ContactSubmission {
  id            Int           @id @default(autoincrement())
  name          String
  email         String
  subject       String
  message       String
  organization  String?
  inquiryType   String        @default("general") @map("inquiry_type")
  status        ContactStatus @default(NEW)
  responseNotes String?       @map("response_notes")
  ipAddress     String?       @map("ip_address")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt], map: "idx_contact_status")
  @@map("contact_submissions")
}

model TelemetryPing {
  organizationId String? @map("organization_id")
  regionId String? @map("region_id")

  id           Int      @id @default(autoincrement())
  volunteerId  Int      @map("volunteer_id")
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  altitude     Decimal? @db.Decimal(8, 2)
  batteryLevel Int?     @map("battery_level")
  speed        Decimal? @db.Decimal(6, 2)
  heading      Decimal? @db.Decimal(5, 2)
  isDistress   Boolean  @default(false) @map("is_distress")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  volunteer    Volunteer? @relation(fields: [organizationId, volunteerId], references: [organizationId, id], onDelete: Cascade)

  @@index([volunteerId, recordedAt], map: "idx_telemetry_volunteer_time")
  @@map("telemetry_pings")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region OrganizationUnit? @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id], map: "telemetry_pings_org_id_key")
  @@index([organizationId, regionId], map: "telemetry_pings_scope_idx")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}

model DispatchJob {
  id          Int       @id @default(autoincrement())
  jobType     String    @map("job_type")
  payload     Json
  priority    Int       @default(10)
  status      String    @default("PENDING")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, priority, createdAt], map: "idx_dispatch_jobs_queue")
  @@map("dispatch_jobs")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique @map("token_hash")
  userId     Int      @map("user_id")
  family     String   @default(uuid())
  isRevoked  Boolean  @default(false) @map("is_revoked")
  expiresAt  DateTime @map("expires_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([tokenHash], map: "idx_refresh_tokens_hash")
  @@index([family], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

model MemberDevice {
  id String @id
  organizationId String @map("organization_id")
  membershipId String @map("membership_id")
  installationId String @map("installation_id")
  platform String
  revokedAt DateTime? @map("revoked_at")
  consentVersion Int @default(1) @map("consent_version")
  locationConsent Boolean @default(false) @map("location_consent")
  sensingConsent Boolean @default(false) @map("sensing_consent")
  relayConsent Boolean @default(false) @map("relay_consent")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  batteryPercent Int? @map("battery_percent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  receipts IngressReceipt[]
  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, id])
  @@unique([organizationId, membershipId, installationId])
  @@map("member_devices")
}

model IngressReceipt {
  id String @id
  organizationId String @map("organization_id")
  deviceId String @map("device_id")
  messageId String @map("message_id")
  payloadHash String @map("payload_hash")
  consentVersion Int @map("consent_version")
  acceptedAt DateTime @default(now()) @map("accepted_at")
  expiresAt DateTime @map("expires_at")
  device MemberDevice @relation(fields: [organizationId, deviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, deviceId, messageId])
  @@index([expiresAt])
  @@map("ingress_receipts")
}

model OrganizationUnit {
  storedObjects StoredObject[]
 forecastBounds Json? @map("forecast_bounds")
 forecastPolicy Json? @map("forecast_policy")
 forecastRuns ForecastRun[]
  scopedVolunteer Volunteer[]
  scopedSkill Skill[]
  scopedVolunteerSkill VolunteerSkill[]
  scopedLocation Location[]
  scopedEvent Event[]
  scopedDeployment Deployment[]
  scopedFieldReport FieldReport[]
  scopedCommunication Communication[]
  scopedNotification Notification[]
  scopedTelemetryPing TelemetryPing[]
  scopedFeedback Feedback[]

 id String @id
 organizationId String @map("organization_id")
 name String
 active Boolean @default(true)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
 @@unique([organizationId, id])
 @@map("organization_units")
}

model ForecastRun {
  id String @id
  organizationId String @map("organization_id")
  regionId String @map("region_id")
  source String
  model String
  initTime DateTime @map("init_time")
  retrievedAt DateTime @map("retrieved_at")
  expiresAt DateTime @map("expires_at")
  payloadHash String @map("payload_hash")
  cells Json
  quality Json
  region OrganizationUnit @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([organizationId, regionId, source, initTime, payloadHash], map: "forecast_run_revision_key")
  @@index([organizationId, regionId, initTime], map: "forecast_run_region_time_idx")
  @@index([expiresAt], map: "forecast_run_expiry_idx")
  @@map("forecast_runs")
}

model HazardRevision {
 id String @id
 source String
 externalId String @map("external_id")
 revisionAt DateTime @map("revision_at")
 observedAt DateTime @map("observed_at")
 longitude Decimal @db.Decimal(10,7)
 latitude Decimal @db.Decimal(10,7)
 magnitude Decimal? @db.Decimal(5,2)
 depthKm Decimal @db.Decimal(8,2) @map("depth_km")
 status String
 title String
 sourceUrl String @map("source_url")
 receivedAt DateTime @default(now()) @map("received_at")
 @@index([source, externalId, revisionAt], map: "hazard_revision_source_idx")
 @@index([observedAt], map: "hazard_revision_time_idx")
 @@map("hazard_revisions")
}

model StoredObject {
  id String @id
  organizationId String @map("organization_id")
  regionId String @map("region_id")
  uploaderUserId Int @map("uploader_user_id")
  bucket String
  objectKey String @unique @map("object_key")
  fileName String @map("file_name")
  contentType String @map("content_type")
  byteSize Int @map("byte_size")
  checksumSha256 String @map("checksum_sha256")
  state String @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  completedAt DateTime? @map("completed_at")
  etag String?
  versionId String? @map("version_id")
  scannedAt DateTime? @map("scanned_at")
  scanCode String? @map("scan_code")
  region OrganizationUnit @relation(fields: [organizationId, regionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  membership OrganizationMembership @relation(fields: [organizationId, uploaderUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Cascade)
  @@index([organizationId, regionId, uploaderUserId, createdAt], map: "stored_object_owner_idx")
  @@index([state, expiresAt], map: "stored_object_expiry_idx")
  @@map("stored_objects")
}
