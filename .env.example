DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your-api-key"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
JWT_SECRET="generate-with-openssl-rand-hex-64"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-64"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_EXPIRES_IN="15m"
COOKIE_SECURE="true"
COOKIE_DOMAIN=""
PORT="3001"
CORS_ORIGIN="https://volunteerops.org,https://volunteerops-admin.onrender.com"
NODE_ENV="production"
LOG_LEVEL="info"
