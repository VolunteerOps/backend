DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your-api-key"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
JWT_SECRET="generate-with-openssl-rand-hex-64"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-64"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_EXPIRES_IN="15m"
COOKIE_SECURE="true"
COOKIE_DOMAIN=""
PORT="3001"
CORS_ORIGIN="https://volunteer.example,https://admin.example"
NODE_ENV="production"
LOG_LEVEL="info"

# Prisma Object Store (server-side only; never embed these in a client app)
S3_ENDPOINT="https://YOUR-OBJECT-STORE-ENDPOINT"
S3_BUCKET="volunteerops-uploads"
S3_ACCESS_KEY_ID="replace-with-bucket-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-bucket-secret-access-key"
S3_REGION="auto"
# Deployment-only credentials; never upload these as application runtime variables.
PRISMA_SERVICE_TOKEN="replace-with-workspace-service-token"
PRISMA_WORKSPACE_ID="replace-with-workspace-id"
