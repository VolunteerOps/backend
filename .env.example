# Sentinel direct PG18/PostGIS runtime connection (non-owner, no BYPASSRLS).
# Do not deploy this branch until the unfinished identity/tenant foundation passes its gates.
DATABASE_URL="postgresql://RUNTIME_USER:PASSWORD@PG18_HOST:5432/volunteerops?sslmode=verify-full"
# Migration job only; never inject owner credentials into the API container.
DIRECT_URL="postgresql://MIGRATION_USER:PASSWORD@PG18_HOST:5432/volunteerops?sslmode=verify-full"
DATABASE_POOL_MAX="3"
DATABASE_CONNECT_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_STATEMENT_TIMEOUT_MS="10000"
# DATABASE_TLS_CA must contain the Railway PostgreSQL public CA PEM.
# HTTP authentication uses Firebase only. Local JWT secrets are no longer needed.
COOKIE_SECURE="true"
COOKIE_DOMAIN=""
PORT="3001"
CORS_ORIGIN="https://volunteer.example,https://admin.example"
NODE_ENV="production"
LOG_LEVEL="info"

# Server-only Firebase HTTP authentication. Apply reviewed identity/outbox migrations first.
FIREBASE_PROJECT_ID="replace-with-firebase-project"
FIREBASE_ALLOW_AUTH_EMULATOR="false"
# Use workload identity/ADC, or GOOGLE_APPLICATION_CREDENTIALS pointing to a secret-mounted file.
# Local tests only: demo- project, FIREBASE_ALLOW_AUTH_EMULATOR=true, FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099.

# Railway private bucket (server-side only; never embed these in a client app)
S3_ENDPOINT="https://YOUR-OBJECT-STORE-ENDPOINT"
S3_BUCKET="volunteerops-uploads"
S3_ACCESS_KEY_ID="replace-with-bucket-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-bucket-secret-access-key"
S3_REGION="auto"
# Deployment-only credentials; never upload these as application runtime variables.

# WeatherNext 3: enable only after dataset and runtime identity access are verified.
WEATHERNEXT_ACCESS_ENABLED=false
WEATHERNEXT_PROJECT_ID=
WEATHERNEXT_BILLING_PROJECT_ID=
WEATHERNEXT_DATASET_ID=
WEATHERNEXT_LOCATION=US
WEATHERNEXT_MAX_BYTES_BILLED=
SENTINEL_USGS_ENABLED=false
# Meta Model API, backend only: muse-spark-1.3 and muse-wonder-1.0.
META_MODEL_API_KEY=
# MODEL_API_KEY is accepted as a compatibility alias.
# Browser-safe public token only (pk.), restricted to your deployed origins.
MAPBOX_ACCESS_TOKEN=

# Public browser configuration (never put an Admin SDK private key here).
FIREBASE_WEB_API_KEY=

# RevenueCat v1 customer verification, bound to the authenticated Firebase UID.
# Public SDK keys can read customer status; they cannot grant Pro access.
REVENUECAT_OPS_API_KEY=
REVENUECAT_API_KEY=
# Optional server-only v1 credentials take precedence over the public keys.
REVENUECAT_OPS_SECRET_API_KEY=
REVENUECAT_SECRET_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_ENTERPRISE_PROVIDERS=

# Set true only for an S3 endpoint verified to require path-style addressing.
S3_FORCE_PATH_STYLE=false

# Staging backup service only; explicitly separate from the API identity.
BACKUP_DATABASE_URL="postgresql://sentinel_backup:PASSWORD@localhost:15432/volunteerops?sslmode=verify-full"
BACKUP_ENCRYPTION_KEY_B64="REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES"
BACKUP_S3_ENDPOINT="https://t3.storageapi.dev"
BACKUP_S3_REGION="auto"
BACKUP_S3_BUCKET="REPLACE_WITH_RECOVERY_BUCKET_NAME"
BACKUP_S3_ACCESS_KEY_ID="REPLACE_WITH_RECOVERY_ACCESS_KEY"
BACKUP_S3_SECRET_ACCESS_KEY="REPLACE_WITH_RECOVERY_SECRET_KEY"
S3_FORCE_PATH_STYLE="false"
TRUST_PROXY_CIDRS=""
# See docs/stage-1-manual-setup.md for rotation, local tunnel and cloud synchronization.

# Stage 2 invitation email. Enable only after verifying your own sending domain.
INVITATION_EMAIL_ENABLED=false
INVITATION_EMAIL_FROM=
RESEND_API_KEY=
VOLUNTEER_APP_ORIGIN=https://resq-volunteer-staging.up.railway.app

# Public Firebase Web API key; never place a service-account private key here.
FIREBASE_WEB_API_KEY=

# Incident feeds: GDACS is always included; add credible RSS feeds as Name=https://... entries.
INCIDENT_FEEDS_ENABLED=false
INCIDENT_RSS_FEEDS=
